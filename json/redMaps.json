{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": {
      "expr": "'Lifetime Suicidal Thoughts Among 16-24 Year-Olds - ' + select_gender"
    }
  },
  "width": "container",
  "projection": {"type": "mercator"},
  "params": [
    {
      "name": "select_gender",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "Male", "Female"],
        "name": "Select Gender:"
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/eibi0001/DataVis/main/json/ne_10m_1.json",
        "format": {"type": "topojson", "feature": "ne_10m_graticules_10"}
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#ccc",
        "fill": "none",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/eibi0001/DataVis/main/json/ne_10m_1.json",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_1_states_provinces"
        }
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/eibi0001/DataVis/main/data/ThoughtsByRegion.csv"
            },
            "key": "Region",
            "fields": ["All", "Male", "Female"]
          }
        },
        {
          "calculate": "select_gender == 'All' ? datum.All : select_gender == 'Male' ? datum.Male : datum.Female",
          "as": "Percent"
        },
        {"calculate": "select_gender", "as": "Gender"}
      ],
      "mark": {"type": "geoshape"},
      "encoding": {
        "color": {
          "field": "Percent",
          "type": "quantitative",
          "scale": {"type": "linear", "scheme": "reds", "domain": [15, 35]}
        },
        "tooltip": [
          {"field": "properties.name", "type": "nominal", "title": "Region"},
          {"field": "Gender", "type": "nominal", "title": "Gender"},
          {
            "field": "Percent",
            "type": "quantitative",
            "title": "% with Suicidal Thoughts"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/eibi0001/DataVis/main/json/ne_10m_1.json",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_1_states_provinces"
        }
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "black"
      },
      "encoding": {
        "text": {"field": "properties.name"},
        "longitude": {"field": "properties.longitude"},
        "latitude": {"field": "properties.latitude"}
      },
      "transform": [
        {
          "filter": "datum.properties.name != 'Australian Capital Territory' && datum.properties.name != 'Ashmore and Cartier Islands' && datum.properties.name != 'Coral Sea Islands' && datum.properties.name != 'Jervis Bay Territory' && datum.properties.name != 'Nusa Tenggara Timur'"
        }
      ]
    }
  ],
  "config": {}
}
